---
import LabelPostList from "../../components/LabelPostList.astro";
import {countLabels, getPostsByLabel} from "../../utils/labels";
import {getBlogPosts, sortPostsByDate} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getBlogPosts());
  return Object.keys(countLabels(posts, 'tags')).map((tag) => ({
    params: {tag},
    props: {tag, posts: getPostsByLabel(posts, 'tags', tag)},
  }));
}

const {tag, posts} = Astro.props;
---

<LabelPostList type="tag" label={tag} posts={posts}/>
