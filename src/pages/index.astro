---
import PostView from '../components/PostView.astro'
import IndexPage from '../layouts/IndexPage.astro'
import Pagination from "../components/Pagination.astro";
import {site} from "../consts";
import {getBlogPosts, orderPostsBySticky, paginate} from "../utils/posts";

const pages = paginate(orderPostsBySticky(await getBlogPosts()), site.postPageSize);
---

<IndexPage>
  {
    (pages[0] ?? []).map(blog =>
      <PostView blog={blog}></PostView>)
  }
  <Pagination currentPage={1} totalPage={pages.length} prefixUrl="/blog/" firstPageHref="/"/>
</IndexPage>
