---
import IndexPage from "../../layouts/IndexPage.astro";
import Pagination from "../../components/Pagination.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import {site} from "../../consts";
import {getBlogPosts, paginate, sortPostsByDate} from "../../utils/posts";

// 1ページ目は /archive (index.astro) が担うため、2ページ目以降のみ生成する
export async function getStaticPaths() {
  const pages = paginate(sortPostsByDate(await getBlogPosts()), site.archivePageSize);
  return pages.slice(1).map((posts, index) => ({
    params: {page: String(index + 2)},
    props: {posts, currentPage: index + 2, totalPage: pages.length},
  }));
}

const {posts, currentPage, totalPage} = Astro.props;
---

<IndexPage title={`アーカイブ - ${currentPage}ページ目`}>
  <ArchiveList posts={posts}/>
  <Pagination currentPage={currentPage} totalPage={totalPage} prefixUrl="/archive/" firstPageHref="/archive/"/>
</IndexPage>
