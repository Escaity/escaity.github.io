---
import IndexPage from "../../layouts/IndexPage.astro";
import Pagination from "../../components/Pagination.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import {site} from "../../consts";
import {getBlogPosts, paginate, sortPostsByDate} from "../../utils/posts";

const pages = paginate(sortPostsByDate(await getBlogPosts()), site.archivePageSize);
---

<IndexPage title="アーカイブ">
  <ArchiveList posts={pages[0] ?? []} titleHover={false}/>
  <Pagination currentPage={1} totalPage={pages.length} prefixUrl="/archive/" firstPageHref="/archive/"/>
</IndexPage>
