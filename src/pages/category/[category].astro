---
import LabelPostList from "../../components/LabelPostList.astro";
import {countLabels, getPostsByLabel} from "../../utils/labels";
import {getBlogPosts, sortPostsByDate} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getBlogPosts());
  return Object.keys(countLabels(posts, 'category')).map((category) => ({
    params: {category},
    props: {category, posts: getPostsByLabel(posts, 'category', category)},
  }));
}

const {category, posts} = Astro.props;
---

<LabelPostList type="category" label={category} posts={posts}/>
