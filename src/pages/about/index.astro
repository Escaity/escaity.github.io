---
import IndexPage from "src/layouts/IndexPage.astro";
const posts = Object.values(import.meta.glob("./_about.md", { eager: true }));
let {Content, frontmatter} = posts[0];
---

<IndexPage frontmatter={frontmatter} title={frontmatter.title || 'About'}>
  <article class="markdown-body">
    <Content/>
  </article>
</IndexPage>
