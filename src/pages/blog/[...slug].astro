---
import {render} from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro'
import PostTitle from "../../components/PostTitle.astro";
import {sortPostsByDate} from "../../utils/sortPostsByDate";
import {getBlogPosts} from "../../utils/posts";
import {getGitContentDates} from "../../utils/gitContentDates";

export async function getStaticPaths() {
  const blogEntries = await getBlogPosts();
  return blogEntries.map(entry => ({
    params: {slug: entry.id}, props: {entry,},
  }));
}

const {entry} = Astro.props;
const {Content, headings, remarkPluginFrontmatter} = await render(entry);

const lastModified = remarkPluginFrontmatter.lastModified
const readingTime = remarkPluginFrontmatter.readingTime

// OGP / 構造化データ用の公開日・更新日(更新日は画面の「最終更新日」を表示する場合のみ)
const publishedDate = new Date(entry.data.date);
const modifiedDate = lastModified ? getGitContentDates(entry.filePath).lastCommittedAt : undefined;

// モバイル用目次(サイドバーの tocbot と同じく h1〜h3 を対象)
const tocHeadings = entry.data.toc ? headings.filter(heading => heading.depth <= 3) : [];
const tocMinDepth = Math.min(...tocHeadings.map(heading => heading.depth));

const posts = await getBlogPosts();
const sortPosts = sortPostsByDate(posts);

const currentPostIndex = sortPosts.findIndex(
  (postItem) => postItem.id === entry.id
);
let prevPost, nextPost
if (sortPosts[currentPostIndex - 1]) {
  prevPost = sortPosts[currentPostIndex - 1];
}
if (sortPosts[currentPostIndex + 1]) {
  nextPost = sortPosts[currentPostIndex + 1];
}
---
<BlogPost
  frontmatter={entry.data}
  ogImage={`/og/${entry.id}.png`}
  publishedTime={publishedDate.toISOString()}
  modifiedTime={modifiedDate?.toISOString()}
>
  <div>
    <PostTitle slug={`/blog/${entry.id}`} {...entry.data} lastModified={lastModified} readingTime={readingTime}></PostTitle>
    <div class="divider-horizontal"></div>
    {
      tocHeadings.length >= 2 && (
        <details class="xl:hidden mb-6 rounded-lg shadow-md bg-skin-card px-4 py-2">
          <summary class="cursor-pointer select-none font-bold">
            <i class="ri-list-check menu-icon"/>目次
          </summary>
          <ol class="mt-2 text-sm">
            {
              tocHeadings.map(heading => (
                <li style={`padding-left: ${heading.depth - tocMinDepth}rem`}>
                  <a class="block py-1 hover:text-skin-active" href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))
            }
          </ol>
        </details>
      )
    }
    <article class="markdown-body">
      <Content/>
    </article>
    <div class="divider-horizontal"></div>
    <div class="h-8 text-skin-base">
      {
        prevPost ? (
          <a
            class="truncate  w-auto max-w-[40%] float-left"
            href={'/' + prevPost.collection + '/' + prevPost.id}
            title={prevPost.data.title}
          >
            <i class="ri-arrow-left-s-fill"/>
            {prevPost.data.title}
          </a>
        ) : (
          <div/>
        )
      }
      {
        nextPost ? (
          <div class="flex item-center float-right w-auto max-w-[40%] text-right">
            <a class="truncate " href={'/' + nextPost.collection + '/' + nextPost.id} title={nextPost.data.title}>
              {nextPost.data.title}
            </a>
            <i class="ri-arrow-right-s-fill float-right"/>
          </div>
        ) : (
          <div/>
        )
      }
    </div>
  </div>

</BlogPost>
