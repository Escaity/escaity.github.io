---
import PostView from '../../components/PostView.astro'
import IndexPage from '../../layouts/IndexPage.astro'
import Pagination from '../../components/Pagination.astro';
import {site} from "../../consts";
import {getBlogPosts, orderPostsBySticky, paginate} from "../../utils/posts";

// 1ページ目は / (index.astro) が担うため、2ページ目以降のみ生成する
export async function getStaticPaths() {
  const pages = paginate(orderPostsBySticky(await getBlogPosts()), site.postPageSize);
  return pages.slice(1).map((posts, index) => ({
    params: {page: String(index + 2)},
    props: {posts, currentPage: index + 2, totalPage: pages.length},
  }));
}

const {posts, currentPage, totalPage} = Astro.props;
---

<IndexPage title={`ブログ - ${currentPage}ページ目`}>
  {
    posts.map(blog =>
      <PostView blog={blog}></PostView>)
  }
  <Pagination currentPage={currentPage} totalPage={totalPage} prefixUrl="/blog/" firstPageHref="/"/>
</IndexPage>
