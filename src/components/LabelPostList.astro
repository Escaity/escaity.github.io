---
// カテゴリー・タグ別の記事一覧ページ
import IndexPage from "../layouts/IndexPage.astro";
import {formatDate} from "../utils/formatDate";

const {label, type, posts} = Astro.props;
const typeName = type === 'tag' ? 'タグ' : 'カテゴリー';
const displayLabel = label === 'uncategorized' ? '未分類' : label;

// 記事がこの件数未満の一覧ページは内容が薄いため noindex にする(sitemap からも自動で除外される)
const MIN_POSTS_FOR_INDEX = 2;
const MAX_DESCRIPTION_LENGTH = 120;

// 「〇〇」タグの記事一覧(N件)。記事タイトル1、記事タイトル2… を 120 字程度に収める
const getDescription = () => {
  let description = `「${label}」${typeName}の記事一覧（${posts.length}件）。`;
  for (const [index, post] of posts.entries()) {
    const next = `${index === 0 ? '' : '、'}${post.data.title}`;
    if ((description + next).length > MAX_DESCRIPTION_LENGTH) {
      return index === 0 ? description : `${description}など`;
    }
    description += next;
  }
  return description;
};
---

<IndexPage title={`${typeName}: ${label}`} description={getDescription()} noindex={posts.length < MIN_POSTS_FOR_INDEX}>
  <h1 class="my-2 text-wrap break-all">
    <span class="text-skin-active mx-1">{displayLabel}</span>
    {typeName}の記事{`（${posts.length}件）`}
  </h1>
  <ul class="text-skin-base">
    {
      posts.map((post) => (
        <li style="list-style-type: disc;" class="ml-4 my-2">
          <a href={`/blog/${post.id}/`}>
            <span class="mr-4">
              {formatDate(post.data.date)}
            </span>
            <span class="hover:text-skin-active">
              {post.data.title}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</IndexPage>
