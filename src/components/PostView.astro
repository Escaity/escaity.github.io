---
import PostViewTitle from '../components/PostViewTitle.astro'
const {blog} = Astro.props;
const {data, id} = blog
---

<div class="relative shadow-md rounded-xl p-4 bg-skin-fill hover:shadow-lg transition-shadow">
  <PostViewTitle
    slug={`/blog/${id}`}
    {...data}
  >
  </PostViewTitle>
  <p class="break-all text-skin-base line-clamp-2">
    {data.description || ''}
  </p>
</div>
