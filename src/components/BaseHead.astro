---
import '../styles/index.css'
import {site} from "../consts";
import {OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH} from '../utils/ogImage';
// GA4 の測定 ID(G-XXXX)が環境変数にあるときだけ gtag.js を読み込む
const gaId = import.meta.env.PUBLIC_GA_ID;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// ページ個別のタイトル・説明文(未指定時はサイト共通の値にフォールバック)
const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og.png',
  publishedTime,
  modifiedTime,
  tags = [],
  categories = [],
  // 検索ページ・404 など検索結果に出す必要のないページ
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const pageDescription = description || site.description;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const isArticle = ogType === 'article';

// 構造化データ(記事は BlogPosting、トップページは WebSite)
const author = {'@type': 'Person', name: site.author, url: new URL('/about/', Astro.site).href};
const jsonLd = isArticle
  ? {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: pageDescription,
    image: ogImageUrl,
    url: canonicalURL.href,
    mainEntityOfPage: canonicalURL.href,
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    author,
    publisher: author,
    keywords: tags.length > 0 ? tags.join(',') : undefined,
    articleSection: categories[0],
    inLanguage: 'ja',
  }
  : Astro.url.pathname === '/'
    ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.title,
      description: site.description,
      url: new URL('/', Astro.site).href,
      author,
      inLanguage: 'ja',
    }
    : undefined;
---
<head>
  <!-- Google tag (gtag.js) -->
  {gaId?.startsWith('G-') && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}/>
      <script define:vars={{gaId}}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  <!-- Global Metadata -->
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <link rel="icon" type="image/svg+xml" href={site.favicon}/>
  <meta name="generator" content={Astro.generator}/>
  <!-- Canonical URL(noindex のページには付けない) -->
  {noindex ? <meta name="robots" content="noindex, follow"/> : <link rel="canonical" href={canonicalURL}/>}
  <!-- RSS Autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title={site.title} href={new URL('rss.xml', Astro.site)}/>

  <!-- Primary Meta Tags -->
  <meta name="title" content={pageTitle}/>
  <meta name="description" content={pageDescription}/>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}/>
  <meta property="og:site_name" content={site.title}/>
  <meta property="og:locale" content="ja_JP"/>
  <meta property="og:url" content={canonicalURL}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={pageDescription}/>
  <meta property="og:image" content={ogImageUrl}/>
  <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)}/>
  <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)}/>
  <meta property="og:image:alt" content={pageTitle}/>
  {isArticle && publishedTime && <meta property="article:published_time" content={publishedTime}/>}
  {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime}/>}
  {isArticle && categories.map(category => <meta property="article:section" content={category}/>)}
  {isArticle && tags.map(tag => <meta property="article:tag" content={tag}/>)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:creator" content={site.twitter}/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={pageDescription}/>
  <meta name="twitter:image" content={ogImageUrl}/>

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}/>}

  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="msapplication-TileColor" content="#da532c"/>
  <meta name="theme-color" content="#ffffff"/>

  <title>{pageTitle}</title>
  <script is:inline src="/toggle-theme.js"></script>

</head>
