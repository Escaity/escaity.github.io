---
const { headings = [] } = Astro.props;
const minimumDepth = headings.length
  ? Math.min(...headings.map(({ depth }) => depth))
  : 0;
---

<div
  id="toc"
  class="shadow-md rounded-lg my-4 py-2 px-2 bg-skin-card sticky top-20"
>
  <div class="flex items-center border-b border-b-gray-300 mb-1">
    <i class="ri-list-check menu-icon"/>
    目次
  </div>
  <div class="overflow-auto">
    <div class="toc-container">
      <ol class="text-sm">
        {headings.map((heading) => (
          <li style={`padding-left: ${heading.depth - minimumDepth}rem`}>
            <a class="block py-1 hover:text-skin-active" href={`#${heading.slug}`}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<script>
  import * as tocbot from "tocbot";

  tocbot.init({
    tocSelector: ".toc-container",
    contentSelector: ".markdown-body",
    headingSelector: "h1,h2,h3",
    hasInnerContainers: true,
    headingsOffset: 80,
    scrollSmoothOffset: -80,
    scrollSmoothDuration: 200,
    collapseDepth: 3,
  });
</script>
