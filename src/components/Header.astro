---
import {archiveLimit, getSidebarData} from "../utils/sidebarData";
import {site, categories, infoLinks} from '../consts';
const {archives, categoryCount} = await getSidebarData();
const {pathname} = Astro.url;
// トップページではサイト名をページの見出し(h1)にする
const SiteTitleTag = pathname === '/' ? 'h1' : 'div';
// ブログ1ページ目は "/" のため、Blog リンクはトップと /blog/* の両方で active にする
const section = pathname.split('/')[1];
const isActive = (href) => href === '/' ? pathname === '/' || section === 'blog' : href.split('/')[1] === section;
---

<header class="fixed top-0 left-0 w-full bg-skin-fill text-skin-base z-10">
  <div class="flex items-center justify-between container">
    <div class="block xl:hidden">
      <button type="button" id="menu-icon" class="header-btn" title="Menu">
        <i class="ri-menu-fill"/>
      </button>
      <button type="button" id="menu-icon-close" class="header-btn hidden" title="Menu">
        <i class="ri-close-fill"/>
      </button>
    </div>
    <SiteTitleTag>
      <a class="ri-home-8-line text-2xl text-skin-accent p-4" href="/"> {site.title}</a>
    </SiteTitleTag>
    <div class="flex items-center">
      <div class="hidden xl:block">
        <div class="flex items-center space-x-5 pr-4">
          {
            categories.map(category => (
              <div class="relative h-10 w-auto flex items-center">
                <a href={category.href} class:list={[isActive(category.href) ? 'header-link-active' : '', 'hover:header-link-hover']}>
                  <i class={category.iconClass}/>
                  {category.name}
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <button type="button" id="theme-btn" class="header-btn" title="Toggles light & dark" aria-label="auto" aria-live="polite">
        <i id="moon-icon" class="ri-sun-line"/>
        <i id="sun-icon" class="ri-moon-line"/>
      </button>
      <div class="block xl:hidden">
        <button type="button" id="aside-btn" class="header-btn" title="Open Aside Bar" aria-label="auto" aria-live="polite">
          <i class="ri-user-line"/>
        </button>
        <button type="button" id="aside-close-btn" class="header-btn hidden" title="Close Aside Bar" aria-label="auto" aria-live="polite">
          <i class="ri-close-fill"/>
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="hidden text-center overflow-y-auto pb-8" style="height: calc(100vh - 64px)">
    {
      categories.map((category) => (
        <div class="py-2">
          <a class="hover:text-skin-active" href={category.href}>
            <i class={category.iconClass}/>
            <span>{category.name}</span>
          </a>
        </div>
      ))
    }
  </div>
  <div id="personal-info" class="hidden break-all overflow-y-auto pb-8" style="height: calc(100vh - 64px)">
    <img class="avatar my-4 mx-auto" src={site.avatar} alt="avatar"/>
    <div class="mb-2 text-center">{site.motto}</div>
    <div class="flex items-center justify-center flex-wrap">
      {
        infoLinks.map((infoItem) => (
          <a title={infoItem.name} href={infoItem.outlink} target="_blank">
            <i class={infoItem.icon + " text-2xl mr-2 cursor-pointer"}/>
          </a>
        ))
      }
    </div>
    <div class="divider-horizontal-mini"></div>
    <div class="text-center">
      {
        Object.keys(categoryCount).length > 0 && (
          <div>
            <i class="ri-folder-line menu-icon"/>カテゴリー
          </div>
        )
      }
      {
        Object.keys(categoryCount).map((category) => (
          <div class="my-2 break-all truncate">
            <a class="hover:text-skin-active" title={category + " (" + categoryCount[category] + ")"} href={"/category/" + category + "/"}>
              {category + " (" + categoryCount[category] + ")"}
            </a>
          </div>

        ))
      }
      {
        archives.length > 0 && (
          <div class="divider-horizontal-mini"></div>
          <div class="text-center">
            <i class="ri-archive-line menu-icon"/>
            アーカイブ
          </div>
        )
      }
      {
        archives.slice(0, archiveLimit).map((archive) => (
          <div class="my-2 break-all truncate">
            <a class="hover:text-skin-active my-2" title={`${archive.label} (${archive.count})`} href={archive.href}>
              {archive.label + " (" + archive.count + ")"}
            </a>
          </div>
        ))
      }
      {
        archives.length > archiveLimit && (
          <div class="my-2">
            <a class="inline-block border rounded-full py-1 px-4 text-sm hover:text-skin-active" href="/archive/">
              もっと見る
            </a>
          </div>
        )
      }
    </div>

  </div>
</header>

<script>
  // モバイル用のメニューとプロフィールの開閉(片方を開くともう片方は閉じる)
  const toggles = [
    ["menu-icon", "menu-icon-close", "mobile-menu"],
    ["aside-btn", "aside-close-btn", "personal-info"],
  ].map((ids) => ids.map((id) => document.getElementById(id)));

  const setOpen = ([openButton, closeButton, panel], open) => {
    openButton.classList.toggle("hidden", open);
    closeButton.classList.toggle("hidden", !open);
    panel.classList.toggle("hidden", !open);
  };

  toggles.forEach((toggle, index) => {
    toggle[0].addEventListener("click", () => {
      setOpen(toggles[1 - index], false);
      setOpen(toggle, true);
    });
    toggle[1].addEventListener("click", () => setOpen(toggle, false));
  });
</script>
