---
let pager = []; // 实际显示的分页组件内容
//prefixUrl : 点击页面跳转的路由地址前缀，比如/blog/1,/tags/1, /category/1等等
const {
  currentPage,
  totalPage,
  prefixUrl = "/blog/",
  firstPageHref = `${prefixUrl}1`,
} = Astro.props;

// ページ番号 → リンク先(1ページ目のみ firstPageHref)
const pageHref = (page) => (page === 1 ? firstPageHref : prefixUrl + page);

if (totalPage === 1) {
  pager = [];
} else if (totalPage <= 5) {
  pager = new Array(totalPage).fill(0).map((i, index) => index + 1);
} else if (currentPage <= totalPage) {
  let diffNextPages = 2 - (totalPage - currentPage);

  let diffPrevPages = currentPage - 1;

  if (diffNextPages <= 2 && diffNextPages >= 0) {
    pager = [
      currentPage - 2 - diffNextPages,
      currentPage - 1 - diffNextPages,
      currentPage - diffNextPages,
      currentPage + 1 - diffNextPages,
      currentPage + 2 - diffNextPages,
    ];
  } else if (diffPrevPages <= 1 && diffPrevPages >= 0) {
    pager = [1, 2, 3, 4, 5];
  } else {
    pager = [
      currentPage - 2,
      currentPage - 1,
      currentPage,
      currentPage + 1,
      currentPage + 2,
    ];
  }
}

---

{pager.length > 0 &&
  <nav class="flex items-center justify-center flex-wrap gap-2 my-16 text-skin-base" aria-label="ページネーション">
    {
      pager.length > 4 && currentPage > 1 && (
        <a href={firstPageHref} title="最初のページ" aria-label="最初のページ">
          <i class="ri-skip-left-line"></i>
        </a>
      )
    }
    {
      currentPage > 1 && (
        <a href={pageHref(currentPage - 1)} title="前のページ" aria-label="前のページ">
          <i class="ri-arrow-left-s-fill"></i>
        </a>
      )
    }
    <!-- 当前分页数据 -->
    {
      pager.map((i) =>
        currentPage === i ? (
          <a
            class="bg-skin-active font-bold"
            href={pageHref(i)}
            aria-current="page"
          >
            {i}
          </a>
        ) : (
          <a href={pageHref(i)}>{i}</a>
        )
      )
    }
    {
      currentPage < totalPage && (
        <a href={pageHref(currentPage + 1)} title="次のページ" aria-label="次のページ">
          <i class="ri-arrow-right-s-fill"></i>
        </a>
      )
    }
    {
      pager.length > 4 && currentPage < totalPage && (
        <a href={prefixUrl + totalPage} title="最後のページ" aria-label="最後のページ">
          <i class="ri-skip-right-line"></i>
        </a>
      )
    }
    <span class="ml-2 text-sm">{currentPage} / {totalPage} ページ</span>
  </nav>
}

<style>
  @reference "../styles/index.css";

  a {
    @apply border rounded cursor-pointer hover:text-skin-active flex items-center justify-center w-11 h-11 text-base;
  }
</style>
